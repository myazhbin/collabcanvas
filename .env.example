# Copy to `.env` and fill in from the Firebase console (Project settings → Your apps →
# SDK setup and configuration), or print the whole object with:
#
#   firebase apps:sdkconfig WEB --project <project-id>
#
# Every var must be VITE_-prefixed — Vite exposes no others to client code — and is
# inlined into the bundle at build time, so a build host missing this file yields
# undefined config and a white screen on load, not a build error [R1].
#
# VITE_FIREBASE_DATABASE_URL is absent from the console snippet entirely if the
# Realtime Database was provisioned after the web app was registered. Provision RTDB
# in us-central1 first, then re-copy [R15].
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
